# plasmidseq.local.config
# Local/site overrides (do NOT commit). Copy next to plasmidseq_submit.sh.
# Suggested gitignore entry:
#   scripts/plasmidseq.local.config

########################
# Environment
########################

# Shared group to apply on gathered outputs (optional)
RESULTS_GROUP="llusers"

# Conda env name or full path (required for mapper tools)
CONDA_ENV="/group/llshared/shared_conda_envs/plasmidseq"

# Optional dedicated pLannotate env (full path). Leave empty to disable.
CONDA_ENV_PLANNOTATE="/group/llshared/shared_conda_envs/plannotate"

# Optional conda init script for non-interactive Slurm jobs
CONDA_INIT=""

# Optional space-separated modules to load
MODULES=""

########################
# Core paths
########################

RESULTS_BASE="/group/llshared/PlasmidSeq/Results"
DEFAULT_TSV="/group/llshared/PlasmidSeq/PL_to_fasta.tsv"
DEFAULT_REFS="/group/llshared/PlasmidSeq/Fasta_Reference_Files"

# Prefer site-provided MYSCRATCH when available
SCRATCH_BASE="${MYSCRATCH:-/scratch/${USER}}"

########################
# Pipeline script resolution
########################

# Leave empty to use this config directory
PIPELINE_SCRIPTS_DIR=""

# Optional explicit script paths
MATCHER_PATH=""
MAPPER_PATH=""

# Optional explicit fallbacks
MATCHER_FALLBACK=""
MAPPER_FALLBACK=""

########################
# Scheduling / notifications
########################

PARTITION_PREP="ll"
PARTITION_MAP="work"
PARTITION_GATHER="ll"

SBATCH_ACCOUNT=""
SBATCH_QOS=""

# Email notifications (optional)
# prep: BEGIN,FAIL  gather: END,FAIL
SLURM_NOTIFY_EMAIL=""

########################
# Performance knobs
########################

# submit -p overrides this
MAX_CONCURRENT_DEFAULT=50

# site array limit (often 1001)
MAX_ARRAY_SIZE=1001

# submit -J overrides MAP_CPUS_PER_TASK
MAP_CPUS_PER_TASK=4
MAP_MEM_PER_CPU="8G"

########################
# Variant calling / annotation
########################

# 0=off, 1=on (CLI -V/-N overrides)
ENABLE_VARIANTS=0
VARSCAN_BIN="varscan"
VARSCAN_JAR=""
VARSCAN_MIN_COVERAGE=10
VARSCAN_MIN_VAR_FREQ=0.01
VARSCAN_PVALUE=0.05

# 0=off, 1=on (CLI -E/-S overrides)
ENABLE_SNPEFF=0

# Dedicated snpEff env (recommended)
SNPEFF_ENV_PREFIX="/group/llshared/shared_conda_envs/plasmidseq_snpeff_env"
SNPEFF_BIN="${SNPEFF_ENV_PREFIX}/bin/snpEff"
SNPEFF_JAVA_HOME="${SNPEFF_ENV_PREFIX}"
SNPEFF_DB=""
SNPEFF_CONFIG_FILE=""
SNPEFF_DATA_DIR=""
